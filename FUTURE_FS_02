<!DOCTYPE html>
<html>
<head>
<title>Mini E-Commerce</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
body{font-family:Arial;background:#f3f4f6}
.product{background:white;padding:15px;margin:10px;border-radius:8px}
button{background:#16a34a;color:white;border:none;padding:8px 12px}
#cart{background:white;padding:15px;margin:10px}
</style>
</head>
<body>

<h2 align="center">Mini E-Commerce Store</h2>

<div class="product">
<h3>Product A</h3>
<p>₹500</p>
<button onclick="add(500)">Add to Cart</button>
</div>

<div class="product">
<h3>Product B</h3>
<p>₹800</p>
<button onclick="add(800)">Add to Cart</button>
</div>

<div id="cart">
<h3>Cart Total: ₹<span id="total">0</span></h3>
<button onclick="checkout()">Checkout</button>
<p id="msg"></p>
</div>

<script>
let total=0;
function add(price){
total+=price;
document.getElementById("total").innerText=total;
}
function checkout(){
document.getElementById("msg").innerText="Order placed successfully!";
}
</script>

</body>
</html>
